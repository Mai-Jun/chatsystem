# ============================================================
# 公共配置（所有子服务共享，随服务自身 flagfile 一起加载：
#   ./xxx_server --flagfile=conf/common.flags --flagfile=conf/xxx_server.flags
# ============================================================

# ---- etcd 注册中心 ----
--etcd_endpoints=http://127.0.0.1:2379
--etcd_lease_ttl=10
--etcd_keepalive_interval=3

# ---- MySQL ----
--mysql_host=127.0.0.1
--mysql_port=3306
--mysql_user=root
--mysql_password=im123456
--mysql_db=im_system

# ---- Redis ----
--redis_host=127.0.0.1
--redis_port=6379

# ---- RabbitMQ ----
--rabbitmq_host=127.0.0.1
--rabbitmq_port=5672
--rabbitmq_user=guest
--rabbitmq_password=guest
--rabbitmq_exchange=im.events

# ---- Elasticsearch ----
--es_host=http://127.0.0.1:9200

# ---- 日志 ----
--log_dir=./logs
--log_level=info
